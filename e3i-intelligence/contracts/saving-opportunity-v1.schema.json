{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.e3isolucoes.com.br/intelligence/saving-opportunity-v1.schema.json",
  "title": "E3I Intelligence Saving Opportunity v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["savingId", "tenantId", "category", "status", "title", "confidence", "createdAt", "updatedAt", "provenance"],
  "properties": {
    "savingId": { "type": "string", "pattern": "^sav-[A-Za-z0-9_-]{8,160}$" },
    "tenantId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "mappingId": { "type": "string", "minLength": 1, "maxLength": 180 },
    "title": { "type": "string", "minLength": 1, "maxLength": 240 },
    "description": { "type": "string", "maxLength": 6000 },
    "category": {
      "type": "string",
      "enum": ["DIRECT_SAVING", "COST_AVOIDANCE", "PRODUCTIVITY", "WORKING_CAPITAL", "RISK_REDUCTION", "OTHER"]
    },
    "status": {
      "type": "string",
      "enum": ["DETECTED", "PROPOSED", "APPROVED", "REALIZED", "VALIDATED", "REJECTED"]
    },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "baselineValue": { "type": "number", "minimum": 0 },
    "estimatedActualValue": { "type": "number", "minimum": 0 },
    "grossSaving": { "type": "number" },
    "implementationCost": { "type": "number", "minimum": 0 },
    "netSaving": { "type": "number" },
    "hoursSaved": { "type": "number", "minimum": 0 },
    "period": {
      "type": "string",
      "enum": ["ONE_TIME", "MONTHLY", "QUARTERLY", "ANNUAL"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "calculationMethod": { "type": "string", "maxLength": 4000 },
    "evidenceRefs": {
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 160 }
    },
    "approvedByActorId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "validatedByActorId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "provenance": { "$ref": "data-provenance-v1.schema.json" }
  }
}
