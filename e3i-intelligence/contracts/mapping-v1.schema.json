{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.e3isolucoes.com.br/intelligence/mapping-v1.schema.json",
  "title": "E3I Intelligence Mapping v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["mappingId", "tenantId", "name", "mappingType", "status", "sources", "createdAt", "updatedAt", "createdByActorId"],
  "properties": {
    "mappingId": { "type": "string", "pattern": "^map-[A-Za-z0-9_-]{8,160}$" },
    "tenantId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "maxLength": 4000 },
    "mappingType": {
      "type": "string",
      "enum": ["PROCESS", "AREA", "AUTOMATION_OPPORTUNITY", "COST", "RISK", "JOURNEY", "OTHER"]
    },
    "status": {
      "type": "string",
      "enum": ["DRAFT", "IN_PROGRESS", "READY_FOR_ANALYSIS", "ANALYZED", "ARCHIVED"]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["E3I_TOOL", "USER_INTERVIEW", "DOCUMENT", "IMPORT", "API", "CALCULATION", "MODEL"]
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "businessArea": { "type": "string", "maxLength": 160 },
        "processOwnerRole": { "type": "string", "maxLength": 160 },
        "startTrigger": { "type": "string", "maxLength": 1000 },
        "endOutcome": { "type": "string", "maxLength": 1000 }
      }
    },
    "activities": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["activityId", "name", "provenance"],
        "properties": {
          "activityId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "name": { "type": "string", "minLength": 1, "maxLength": 240 },
          "description": { "type": "string", "maxLength": 4000 },
          "role": { "type": "string", "maxLength": 160 },
          "system": { "type": "string", "maxLength": 160 },
          "frequencyPerMonth": { "type": "number", "minimum": 0 },
          "workMinutesPerOccurrence": { "type": "number", "minimum": 0 },
          "waitMinutesPerOccurrence": { "type": "number", "minimum": 0 },
          "reworkRate": { "type": "number", "minimum": 0, "maximum": 1 },
          "hourlyCost": { "type": "number", "minimum": 0 },
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "provenance": { "$ref": "data-provenance-v1.schema.json" }
        }
      }
    },
    "facts": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "value", "provenance"],
        "properties": {
          "key": { "type": "string", "minLength": 1, "maxLength": 160 },
          "value": {},
          "unit": { "type": "string", "maxLength": 60 },
          "provenance": { "$ref": "data-provenance-v1.schema.json" }
        }
      }
    },
    "riskRefs": {
      "type": "array",
      "maxItems": 500,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 160 }
    },
    "opportunityRefs": {
      "type": "array",
      "maxItems": 500,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 160 }
    },
    "evidenceRefs": {
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 160 }
    },
    "createdByActorId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
