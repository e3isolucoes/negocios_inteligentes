{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://e3i.dev/contracts/obrigacoes/evidence.schema.json",
  "title": "E3I Obrigações — Evidence Metadata Record",
  "description": "Metadado do comprovante. O binário permanece exclusivamente no S3.",
  "type": "object",
  "required": [
    "id",
    "obligation_id",
    "occurrence_id",
    "attachment_path",
    "storage_provider",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "obligation_id": {
      "type": "string",
      "minLength": 1
    },
    "occurrence_id": {
      "type": "string",
      "minLength": 1
    },
    "attachment_path": {
      "type": "string",
      "minLength": 1
    },
    "storage_provider": {
      "const": "s3"
    },
    "content_type": {
      "type": "string"
    },
    "original_file_name": {
      "type": "string"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "origin",
        "operation",
        "captured_at"
      ],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "user",
            "system",
            "import",
            "integration"
          ]
        },
        "origin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "actor_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "operation": {
          "type": "string",
          "enum": [
            "create",
            "update",
            "recreate",
            "import"
          ]
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_record_id": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": true
}
