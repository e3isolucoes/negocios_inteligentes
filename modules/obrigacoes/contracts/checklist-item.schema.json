{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://e3i.dev/contracts/obrigacoes/checklist-item.schema.json",
  "title": "E3I Obrigações — Checklist Item Record",
  "type": "object",
  "required": [
    "id",
    "obligation_id",
    "description",
    "position",
    "done",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "obligation_id": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "position": {
      "type": "integer",
      "minimum": 0
    },
    "done": {
      "type": "boolean"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "completed_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "origin",
        "operation",
        "captured_at"
      ],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "user",
            "system",
            "import",
            "integration"
          ]
        },
        "origin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "actor_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "operation": {
          "type": "string",
          "enum": [
            "create",
            "update",
            "recreate",
            "import"
          ]
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_record_id": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": true
}
